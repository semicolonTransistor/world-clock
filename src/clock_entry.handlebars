<td>
    <input type="text" class="city-input searchable-input" value="{{city}}" name="city">
    <div class="dropdown-content">
    </div>
</td>
<td>
    <input type="text" , class="time-zone-input searchable-input" value="{{timeZone}}" name="time-zone">
    <div id="myDropdown" class="dropdown-content">
    </div>
</td>
<td>
    <div class="clock" data-time-zone="{{timeZone}}">
        <span class="clock-field" data-format="cccc HH:mm:ss">00:00</span>
    </div>
</td>
<td>
    <button class="clock-entry-up-btn">Up</button>
    <button class="clock-entry-down-btn">Down</button>
    <button class="clock-entry-delete-btn">Delete</button>
</td>