<div>
    <div id="navbar-trigger">
    </div>
    {{> navbar}}
    <div class="centering-container">
        <div class="clock local_clock">
            <div class="centering-container">
                <div>
                    <span class="clock-field clock-hour-min" data-format="HH:mm">00:00</span>
                    <span class="clock-field clock-sec-small" data-format="ss">00</span>
                </div>
            </div>
            <div class="centering-container">
                <div>
                    <span class="clock-field clock-aux" data-format="DDDD"></span>
                </div>
            </div>
        </div>
    </div>
    <div id="world-clock-container" class="world-clock-container">
        {{> world_clock }}
    </div>
</div>