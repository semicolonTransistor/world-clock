{{#each clocks}}
    <div class="clock world_clock" data-timezone="{{zoneName}}">
        <div class="world_clock_left">
            <div>
                <span class="clock-location">{{location}}</span>
            </div>
            <div>
                <span class="clock-field world-clock-aux" data-format="'UTC'Z"></span>
            </div>
        </div>
        <span class="world_clock_right">
            <div>
                <span class="clock-field clock-hour-min" data-format="HH:mm">00:00</span>
            </div>
            <div>
                <span class="clock-field world-clock-aux" data-format="cccc"></span>
            </div>
        </span>
    </div>
{{/each}}